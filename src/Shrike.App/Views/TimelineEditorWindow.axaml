<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Shrike.App.Controls"
        x:Class="Shrike.App.Views.TimelineEditorWindow"
        Title="Shrike — Trim &amp; Export"
        Width="960" Height="640"
        MinWidth="640" MinHeight="460"
        Background="#140F0A"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="Button.tool">
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Background" Value="#2A2318" />
            <Setter Property="Foreground" Value="#EDE6DA" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A2F1E" />
            <Setter Property="BorderBrush" Value="#F5A524" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#F5A524" />
            <Setter Property="Foreground" Value="#140F0A" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFB840" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="#9A8F7D" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Styles>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="248" MinWidth="200" MaxWidth="480" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" RowDefinitions="3*,Auto,2*" Margin="14">
        <!-- Preview + transport — resizable against the timeline below via the splitter. -->
        <Grid Grid.Row="0" RowDefinitions="*,Auto" MinHeight="180">
            <!-- Preview (with the inline annotation surface overlaid for canvas editing) -->
            <Border Grid.Row="0" Background="#000000" CornerRadius="8" ClipToBounds="True">
                <Panel>
                    <controls:PreviewSurface Name="Preview" />
                    <controls:AnnotationSurface Name="CanvasSurface" IsVisible="False" />
                </Panel>
            </Border>

            <!-- Transport (Play button fixed-width so the ▶/❚❚ swap doesn't shift the row) -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" Margin="2,12,2,4">
                <Button Grid.Column="0" Name="PlayButton" Classes="tool" Width="96"
                        HorizontalContentAlignment="Center" Content="▶ Play" Click="OnPlayPause" />
                <TextBlock Grid.Column="1" Name="TimeLabel" Classes="hint" VerticalAlignment="Center"
                           Margin="12,0,0,0" FontFamily="Consolas,monospace" Text="00:00 / 00:00" />
                <Button Grid.Column="2" Name="VoiceoverButton" Classes="tool" HorizontalAlignment="Left"
                        Margin="16,0,0,0" Content="● Voiceover" Click="OnVoiceover" IsVisible="False"
                        ToolTip.Tip="Record narration over the playing preview" />
                <TextBlock Grid.Column="3" Name="KeptLabel" Classes="hint" VerticalAlignment="Center" />
            </Grid>
        </Grid>

        <!-- Draggable divider: trade preview height for more room to see the effects timeline. -->
        <GridSplitter Grid.Row="1" Height="6" ResizeDirection="Rows" HorizontalAlignment="Stretch"
                      Background="#241C12" ShowsPreview="False" />

        <!-- Timeline: ruler, scrubber, the effects lane (scrolls when tall), toolbar. A Canvas overlay carries
             the floating Cut/Keep bar so it can sit above the strip without affecting the timeline's layout. -->
        <Grid Grid.Row="2" MinHeight="150">
          <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
            <!-- Time axis (source time), aligned with the scrubber + effects lane below it. -->
            <controls:TimeRuler Grid.Row="0" Name="TimeRuler" Margin="0,4,0,2" />

            <!-- Scrubber / trim lane. -->
            <controls:TimelineStrip Grid.Row="1" Name="Strip" Margin="0,0,0,10" />

            <!-- Audio waveform lane (shown from code-behind when the clip carries captured audio). -->
            <controls:WaveformLane Grid.Row="2" Name="WaveLane" IsVisible="False" Margin="0,0,0,10" />

            <!-- Effects lane (shown + wired from code-behind when a track is present); scrolls when it grows tall. -->
            <Grid Grid.Row="3" Name="EffectsPanel" IsVisible="False" RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,0,0,6">
                    <TextBlock Text="✦ Effects" Foreground="#F5A524" FontFamily="Consolas,monospace" FontSize="12" VerticalAlignment="Center" />
                    <Button Name="AddEffectButton" Classes="tool" Content="+ Add effect" />
                    <TextBlock Name="EffectsHint" Classes="hint" VerticalAlignment="Center"
                               Text="right-click to add · drag to move / resize · double-click adds a zoom · Ctrl+scroll to zoom the timeline, Shift+scroll to pan" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <controls:EffectsLane Name="EffectsLane" VerticalAlignment="Top" />
                </ScrollViewer>
            </Grid>

            <!-- Toolbar -->
            <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,8,0,0">
                <Button Grid.Column="0" Classes="tool" Content="Reset trim" Click="OnResetAll" Margin="0,0,6,0" />
                <!-- Debug-only: shown + wired in code-behind (#if DEBUG). Reveals this recording + its .track.json. -->
                <Button Grid.Column="1" Name="RevealButton" Classes="tool" Content="Reveal files (debug)"
                        HorizontalAlignment="Left" IsVisible="False" Margin="0,0,6,0" />
                <TextBlock Grid.Column="2" Classes="hint" VerticalAlignment="Center"
                           Text="drag ends to trim · drag a boundary to move it · right-click to split / cut / keep · double-click a span to edit · Ctrl+drag adds a split" />
                <Button Grid.Column="3" Classes="tool accent" Content="Export…" Click="OnExport" />
            </Grid>
          </Grid>

          <!-- Overlay: the floating Cut/Keep bar, positioned absolutely (Canvas.Left/Top) above the strip. -->
          <Canvas Name="TimelineOverlay" ClipToBounds="False">
              <Border Name="SelectionBar" IsVisible="False"
                      Background="#1C1710" BorderBrush="#F5A524" BorderThickness="1" CornerRadius="6" Padding="4,3">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                      <Button Name="CutSelectionButton" Classes="tool" Content="✂ Cut" />
                      <Button Name="KeepSelectionButton" Classes="tool" Content="Keep" />
                      <Button Name="KeepOnlySelectionButton" Classes="tool" Content="Keep only" />
                      <Button Name="ClearSelectionButton" Classes="tool" Content="✕" />
                  </StackPanel>
              </Border>
          </Canvas>
        </Grid>
        </Grid>

        <!-- Draggable divider so the properties pane can be widened/narrowed. -->
        <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns"
                      Background="#241C12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Right pane: always present (its column is reserved, so selecting an effect never reflows the editor).
             Content swaps to the selected effect's/segment's editor, or an empty-state hint. Resizable. -->
        <Border Grid.Column="2" Name="PropsPane" IsVisible="False"
                Background="#1A150E" BorderBrush="#322A1E" BorderThickness="1,0,0,0" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
                <TextBlock Name="PaneHeader" Text="✦ Effect" Foreground="#F5A524" FontFamily="Consolas,monospace" FontSize="12" />

                <!-- Empty / no-editor-yet state. -->
                <TextBlock Name="PaneEmpty" Classes="hint" TextWrapping="Wrap"
                           Text="Select an effect on the timeline to edit it, or right-click the timeline to add one." />

                <!-- Timing (every effect). -->
                <StackPanel Name="TimingEditor" Spacing="12" IsVisible="False">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Start (s)" Classes="hint" />
                        <NumericUpDown Name="StartInput" Minimum="0" Increment="0.1" FormatString="0.0#" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="End (s)" Classes="hint" />
                        <NumericUpDown Name="EndInput" Minimum="0" Increment="0.1" FormatString="0.0#" />
                    </StackPanel>
                </StackPanel>

                <!-- Zoom editor. -->
                <StackPanel Name="ZoomEditor" Spacing="16" IsVisible="False">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Zoom (×)" Classes="hint" />
                        <NumericUpDown Name="ZoomAmountInput" Minimum="1.1" Maximum="3.0" Increment="0.1" FormatString="0.0#" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="Ease in (s)" Classes="hint" />
                        <NumericUpDown Name="EaseInInput" Minimum="0" Maximum="3" Increment="0.1" FormatString="0.0#" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="Ease out (s)" Classes="hint" />
                        <NumericUpDown Name="EaseOutInput" Minimum="0" Maximum="3" Increment="0.1" FormatString="0.0#" />
                    </StackPanel>
                </StackPanel>

                <!-- Spotlight editor. -->
                <StackPanel Name="SpotlightEditor" Spacing="16" IsVisible="False">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Colour (hex)" Classes="hint" />
                        <TextBox Name="SpotlightColorInput" PlaceholderText="#FFD24A" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="Opacity" Classes="hint" />
                        <Slider Name="SpotlightOpacityInput" Minimum="0.1" Maximum="1.0" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="Radius (px)" Classes="hint" />
                        <NumericUpDown Name="SpotlightRadiusInput" Minimum="12" Maximum="160" Increment="2" FormatString="0" />
                    </StackPanel>
                </StackPanel>

                <!-- Visibility (cursor) editor — also home to the cursor's global smoothness/size tuning. -->
                <StackPanel Name="VisibilityEditor" Spacing="14" IsVisible="False">
                    <CheckBox Name="VisibilityInput" Content="Cursor shown" Foreground="#B8AE9C" />
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="Uncheck to hide the cursor for this span. The default full-length block keeps the cursor shown." />
                    <StackPanel Spacing="5">
                        <TextBlock Text="Smoothness" Classes="hint" />
                        <Slider Name="SmoothnessSlider" Minimum="0" Maximum="100" />
                        <TextBlock Name="SmoothnessValue" Classes="hint" FontFamily="Consolas,monospace" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="Cursor size" Classes="hint" />
                        <Slider Name="SizeSlider" Minimum="0.5" Maximum="2.0" />
                        <TextBlock Name="SizeValue" Classes="hint" FontFamily="Consolas,monospace" />
                    </StackPanel>
                    <Button Name="SmoothingReset" Classes="tool" Content="Reset cursor look" HorizontalAlignment="Stretch" />
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="Smoothness and size apply to the cursor throughout the clip." />
                </StackPanel>

                <!-- Canvas editor. -->
                <StackPanel Name="CanvasEditor" Spacing="10" IsVisible="False">
                    <CheckBox Name="CanvasScreenSpace" Foreground="#B8AE9C" Content="Fixed on screen (ignore zoom)" />
                    <StackPanel Spacing="5">
                        <TextBlock Text="Animation" Classes="hint" />
                        <ComboBox Name="CanvasAnimCombo" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="None (static)" />
                            <ComboBoxItem Content="Fade in / out" />
                            <ComboBoxItem Content="Slide from left" />
                            <ComboBoxItem Content="Slide from right" />
                            <ComboBoxItem Content="Slide from bottom" />
                            <ComboBoxItem Content="Pop in" />
                        </ComboBox>
                    </StackPanel>
                    <ToggleButton Name="CanvasEditToggle" Classes="tool" HorizontalAlignment="Stretch" Content="✎ Edit drawing" />
                    <StackPanel Name="CanvasTools" Spacing="8" IsVisible="False">
                        <TextBlock Text="Tool" Classes="hint" />
                        <WrapPanel>
                            <Button Classes="tool" Tag="None" Content="Select" Click="OnCanvasToolClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="Rectangle" Content="Box" Click="OnCanvasToolClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="Ellipse" Content="Ellipse" Click="OnCanvasToolClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="Arrow" Content="Arrow" Click="OnCanvasToolClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="Line" Content="Line" Click="OnCanvasToolClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="Freehand" Content="Pen" Click="OnCanvasToolClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="Highlight" Content="Mark" Click="OnCanvasToolClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="Text" Content="Text" Click="OnCanvasToolClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="StepBadge" Content="Badge" Click="OnCanvasToolClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="Redaction" Content="Redact" Click="OnCanvasToolClick" Margin="0,0,4,4" />
                        </WrapPanel>
                        <TextBlock Text="Colour" Classes="hint" />
                        <WrapPanel>
                            <Button Classes="tool" Tag="#F5A524" Content="●" Foreground="#F5A524" Click="OnCanvasColorClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="#E5484D" Content="●" Foreground="#E5484D" Click="OnCanvasColorClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="#30A46C" Content="●" Foreground="#30A46C" Click="OnCanvasColorClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="#4C8DFF" Content="●" Foreground="#4C8DFF" Click="OnCanvasColorClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="#FFFFFF" Content="●" Foreground="#FFFFFF" Click="OnCanvasColorClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="#141414" Content="●" Foreground="#141414" Click="OnCanvasColorClick" Margin="0,0,4,4" />
                        </WrapPanel>
                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                   Text="Draw on the frame. Redaction is permanent in the export. Click Done when finished." />
                    </StackPanel>
                </StackPanel>

                <!-- Captions editor: generate from narration, fix the text, and style the burned-in look. -->
                <StackPanel Name="CaptionEditor" Spacing="12" IsVisible="False">
                    <Button Name="CaptionGenerateButton" Classes="tool accent" HorizontalAlignment="Stretch"
                            Content="Generate from narration" Click="OnGenerateCaptions" />
                    <ProgressBar Name="CaptionProgress" Minimum="0" Maximum="1" Height="6" IsVisible="False"
                                 Foreground="#5FC28A" Background="#2A2318" CornerRadius="3" />
                    <TextBlock Name="CaptionStatus" Classes="hint" TextWrapping="Wrap"
                               Text="Transcribes your recorded narration on this machine (nothing is uploaded)." />

                    <TextBlock Text="Lines" Classes="hint" />
                    <StackPanel Name="CaptionCueList" Spacing="6" />

                    <TextBlock Text="Style" Classes="hint" Margin="0,4,0,0" />
                    <StackPanel Spacing="5">
                        <TextBlock Text="Text size" Classes="hint" />
                        <Slider Name="CaptionFontScale" Minimum="0.5" Maximum="2.0" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="Text colour (hex)" Classes="hint" />
                        <TextBox Name="CaptionTextColor" PlaceholderText="#FFFFFF" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="Box colour (hex)" Classes="hint" />
                        <TextBox Name="CaptionBoxColor" PlaceholderText="#000000" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="Box opacity" Classes="hint" />
                        <Slider Name="CaptionBoxOpacity" Minimum="0" Maximum="1.0" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="Position" Classes="hint" />
                        <ComboBox Name="CaptionPositionCombo" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Bottom" />
                            <ComboBoxItem Content="Top" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="Max width" Classes="hint" />
                        <Slider Name="CaptionMaxWidth" Minimum="0.3" Maximum="1.0" />
                    </StackPanel>
                </StackPanel>

                <!-- Segment editor (a strip span selected by double-click). -->
                <StackPanel Name="SegmentEditor" Spacing="12" IsVisible="False">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Start (s)" Classes="hint" />
                        <NumericUpDown Name="SegStartInput" Minimum="0" Increment="0.1" FormatString="0.0#" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="End (s)" Classes="hint" />
                        <NumericUpDown Name="SegEndInput" Minimum="0" Increment="0.1" FormatString="0.0#" />
                    </StackPanel>
                    <CheckBox Name="SegKeepToggle" Content="Keep this span" Foreground="#B8AE9C" />
                    <Button Name="RemoveSplitButton" Classes="tool" Content="Remove split" HorizontalAlignment="Stretch" />
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="Uncheck to cut this span. Drag the boundary handles on the strip, or set the times here." />
                </StackPanel>

                <!-- Audio clip editor (shown when the waveform lane is clicked). -->
                <StackPanel Name="AudioEditor" Spacing="14" IsVisible="False">
                    <CheckBox Name="AudioMuteInput" Content="Mute this audio" Foreground="#B8AE9C" />
                    <StackPanel Spacing="5">
                        <TextBlock Text="Gain" Classes="hint" />
                        <Slider Name="AudioGainInput" Minimum="-24" Maximum="12" />
                        <TextBlock Name="AudioGainValue" Classes="hint" FontFamily="Consolas,monospace" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="A/V sync offset (ms)" Classes="hint" />
                        <NumericUpDown Name="AudioOffsetInput" Minimum="-2000" Maximum="2000" Increment="10" FormatString="0" />
                    </StackPanel>
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="Captured audio rides the cuts automatically. Nudge the offset if voice and picture drift (+ = audio later)." />

                    <!-- Clip operations. Drag the block on the lane to move, drag its edges to crop. -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="Clip" Classes="hint" />
                        <WrapPanel>
                            <Button Name="SplitAudioButton" Classes="tool" Content="Split (S)"
                                    Margin="0,0,6,6" Click="OnSplitAudio" />
                            <Button Name="DuplicateAudioButton" Classes="tool" Content="Duplicate (Ctrl+D)"
                                    Margin="0,0,6,6" Click="OnDuplicateAudio" />
                            <Button Name="DeleteAudioButton" Classes="tool" Content="Delete (Del)"
                                    Margin="0,0,0,6" Click="OnDeleteAudio" />
                        </WrapPanel>
                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                   Text="Drag the clip to move it; drag its left or right edge to crop it in place. Split cuts at the playhead." />
                    </StackPanel>

                    <!-- Punch-in re-record (voiceover clips): select a span on the strip, then re-record just it. -->
                    <Button Name="PunchButton" Classes="tool" Content="⦿ Re-record selected span"
                            HorizontalAlignment="Stretch" Click="OnPunchIn" IsVisible="False" />
                    <Button Name="UndoPunchButton" Classes="tool" Content="↶ Undo re-record"
                            HorizontalAlignment="Stretch" Click="OnUndoPunch" IsVisible="False" />
                    <TextBlock Name="PunchHint" Classes="hint" TextWrapping="Wrap" IsVisible="False"
                               Text="Drag a span on the scrubber, then Re-record to replace just that slice of the voiceover." />
                </StackPanel>

                <Button Name="DeleteZoomButton" Classes="tool" Content="Delete effect"
                        HorizontalAlignment="Stretch" IsVisible="False" />
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
