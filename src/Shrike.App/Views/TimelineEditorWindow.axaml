<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Shrike.App.Controls"
        x:Class="Shrike.App.Views.TimelineEditorWindow"
        Title="Shrike — Trim &amp; Export"
        Width="960" Height="640"
        MinWidth="640" MinHeight="460"
        Background="#140F0A"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="Button.tool">
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Background" Value="#2A2318" />
            <Setter Property="Foreground" Value="#EDE6DA" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A2F1E" />
            <Setter Property="BorderBrush" Value="#F5A524" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#F5A524" />
            <Setter Property="Foreground" Value="#140F0A" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFB840" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="#9A8F7D" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="*,Auto">
        <Grid Grid.Column="0" RowDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" Margin="14">
        <!-- Preview (with the inline annotation surface overlaid for canvas editing) -->
        <Border Grid.Row="0" Background="#000000" CornerRadius="8" ClipToBounds="True">
            <Panel>
                <controls:PreviewSurface Name="Preview" />
                <controls:AnnotationSurface Name="CanvasSurface" IsVisible="False" />
            </Panel>
        </Border>

        <!-- Transport -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" Margin="2,12,2,8">
            <Button Grid.Column="0" Name="PlayButton" Classes="tool" Content="▶ Play" Click="OnPlayPause" />
            <TextBlock Grid.Column="1" Name="TimeLabel" Classes="hint" VerticalAlignment="Center"
                       Margin="12,0,0,0" FontFamily="Consolas,monospace" Text="00:00 / 00:00" />
            <TextBlock Grid.Column="3" Name="KeptLabel" Classes="hint" VerticalAlignment="Center" />
        </Grid>

        <!-- Smooth-cursor tuning (debug-only; shown + wired from code-behind when a track is present). -->
        <Border Grid.Row="2" Name="SmoothingPanel" IsVisible="False"
                Background="#1C1710" BorderBrush="#322A1E" BorderThickness="1" CornerRadius="7"
                Padding="10,7" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <TextBlock Text="✦ Cursor" Foreground="#F5A524" FontFamily="Consolas,monospace"
                           FontSize="12" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Smoothness" Classes="hint" VerticalAlignment="Center" />
                    <Slider Name="SmoothnessSlider" Width="150" Minimum="0" Maximum="100" VerticalAlignment="Center" />
                    <TextBlock Name="SmoothnessValue" Classes="hint" Width="34" FontFamily="Consolas,monospace" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Size" Classes="hint" VerticalAlignment="Center" />
                    <Slider Name="SizeSlider" Width="104" Minimum="0.5" Maximum="2.0" VerticalAlignment="Center" />
                    <TextBlock Name="SizeValue" Classes="hint" Width="42" FontFamily="Consolas,monospace" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="hint" VerticalAlignment="Center"
                           Text="cursor / ripple / spotlight are now timeline effects — right-click the lane" />
                <Button Name="SmoothingReset" Classes="tool" Content="Reset" />
            </StackPanel>
        </Border>

        <!-- Time axis (source time), aligned with the scrubber + zoom lane below it. -->
        <controls:TimeRuler Grid.Row="3" Name="TimeRuler" Margin="0,0,0,2" />

        <!-- Scrubber -->
        <controls:TimelineStrip Grid.Row="4" Name="Strip" Margin="0,0,0,10" />

        <!-- Effects lane (shown + wired from code-behind when a track is present). -->
        <StackPanel Grid.Row="5" Name="EffectsPanel" IsVisible="False" Spacing="6" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="✦ Effects" Foreground="#F5A524" FontFamily="Consolas,monospace" FontSize="12" VerticalAlignment="Center" />
                <Button Name="AddEffectButton" Classes="tool" Content="+ Add effect" />
                <TextBlock Name="EffectsHint" Classes="hint" VerticalAlignment="Center"
                           Text="right-click the lane to add an effect · drag to move / resize · double-click adds a zoom · select a zoom to edit it on the right" />
            </StackPanel>
            <controls:EffectsLane Name="EffectsLane" />
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="6" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
            <Button Grid.Column="0" Classes="tool" Content="Mark In"   Click="OnMarkIn"    Margin="0,0,6,0" />
            <Button Grid.Column="1" Classes="tool" Content="Mark Out"  Click="OnMarkOut"   Margin="0,0,6,0" />
            <Button Grid.Column="2" Classes="tool" Content="Cut"       Click="OnCut"       Margin="0,0,6,0" />
            <Button Grid.Column="3" Classes="tool" Content="Keep only" Click="OnKeepOnly"  Margin="0,0,6,0" />
            <Button Grid.Column="4" Classes="tool" Content="Restore"   Click="OnRestoreAt" Margin="0,0,6,0" />
            <Button Grid.Column="5" Classes="tool" Content="Reset"     Click="OnResetAll"  Margin="0,0,6,0" />
            <!-- Debug-only: shown + wired in code-behind (#if DEBUG). Reveals this recording + its .track.json. -->
            <Button Grid.Column="6" Name="RevealButton" Classes="tool" Content="Reveal files (debug)"
                    HorizontalAlignment="Left" IsVisible="False" />
            <Button Grid.Column="7" Classes="tool accent" Content="Export…" Click="OnExport" />
        </Grid>
        </Grid>

        <!-- Right pane: always present (fixed column, so selecting an effect never reflows the editor). Its
             content swaps to the selected effect's editor, or an empty-state hint when nothing is selected. -->
        <Border Grid.Column="1" Name="PropsPane" IsVisible="False" Width="248"
                Background="#1A150E" BorderBrush="#322A1E" BorderThickness="1,0,0,0" Padding="16">
            <StackPanel Spacing="16">
                <TextBlock Name="PaneHeader" Text="✦ Effect" Foreground="#F5A524" FontFamily="Consolas,monospace" FontSize="12" />

                <!-- Empty / no-editor-yet state. -->
                <TextBlock Name="PaneEmpty" Classes="hint" TextWrapping="Wrap"
                           Text="Select an effect on the timeline to edit it, or right-click the timeline to add one." />

                <!-- Zoom editor. -->
                <StackPanel Name="ZoomEditor" Spacing="16" IsVisible="False">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Zoom (×)" Classes="hint" />
                        <NumericUpDown Name="ZoomAmountInput" Minimum="1.1" Maximum="3.0" Increment="0.1" FormatString="0.0#" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="Ease in (s)" Classes="hint" />
                        <NumericUpDown Name="EaseInInput" Minimum="0" Maximum="3" Increment="0.1" FormatString="0.0#" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="Ease out (s)" Classes="hint" />
                        <NumericUpDown Name="EaseOutInput" Minimum="0" Maximum="3" Increment="0.1" FormatString="0.0#" />
                    </StackPanel>
                </StackPanel>

                <!-- Spotlight editor. -->
                <StackPanel Name="SpotlightEditor" Spacing="16" IsVisible="False">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Colour (hex)" Classes="hint" />
                        <TextBox Name="SpotlightColorInput" PlaceholderText="#FFD24A" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="Opacity" Classes="hint" />
                        <Slider Name="SpotlightOpacityInput" Minimum="0.1" Maximum="1.0" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="Radius (px)" Classes="hint" />
                        <NumericUpDown Name="SpotlightRadiusInput" Minimum="12" Maximum="160" Increment="2" FormatString="0" />
                    </StackPanel>
                </StackPanel>

                <!-- Visibility editor. -->
                <StackPanel Name="VisibilityEditor" Spacing="8" IsVisible="False">
                    <CheckBox Name="VisibilityInput" Content="Cursor shown" Foreground="#B8AE9C" />
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="Uncheck to hide the cursor for this span. The default full-length block keeps the cursor shown." />
                </StackPanel>

                <!-- Canvas editor. -->
                <StackPanel Name="CanvasEditor" Spacing="10" IsVisible="False">
                    <CheckBox Name="CanvasScreenSpace" Foreground="#B8AE9C" Content="Fixed on screen (ignore zoom)" />
                    <ToggleButton Name="CanvasEditToggle" Classes="tool" HorizontalAlignment="Stretch" Content="✎ Edit drawing" />
                    <StackPanel Name="CanvasTools" Spacing="8" IsVisible="False">
                        <TextBlock Text="Tool" Classes="hint" />
                        <WrapPanel>
                            <Button Classes="tool" Tag="None" Content="Select" Click="OnCanvasToolClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="Rectangle" Content="Box" Click="OnCanvasToolClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="Ellipse" Content="Ellipse" Click="OnCanvasToolClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="Arrow" Content="Arrow" Click="OnCanvasToolClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="Line" Content="Line" Click="OnCanvasToolClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="Freehand" Content="Pen" Click="OnCanvasToolClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="Highlight" Content="Mark" Click="OnCanvasToolClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="Text" Content="Text" Click="OnCanvasToolClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="StepBadge" Content="Badge" Click="OnCanvasToolClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="Redaction" Content="Redact" Click="OnCanvasToolClick" Margin="0,0,4,4" />
                        </WrapPanel>
                        <TextBlock Text="Colour" Classes="hint" />
                        <WrapPanel>
                            <Button Classes="tool" Tag="#F5A524" Content="●" Foreground="#F5A524" Click="OnCanvasColorClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="#E5484D" Content="●" Foreground="#E5484D" Click="OnCanvasColorClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="#30A46C" Content="●" Foreground="#30A46C" Click="OnCanvasColorClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="#4C8DFF" Content="●" Foreground="#4C8DFF" Click="OnCanvasColorClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="#FFFFFF" Content="●" Foreground="#FFFFFF" Click="OnCanvasColorClick" Margin="0,0,4,4" />
                            <Button Classes="tool" Tag="#141414" Content="●" Foreground="#141414" Click="OnCanvasColorClick" Margin="0,0,4,4" />
                        </WrapPanel>
                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                   Text="Draw on the frame. Redaction is permanent in the export. Click Done when finished." />
                    </StackPanel>
                </StackPanel>

                <Button Name="DeleteZoomButton" Classes="tool" Content="Delete effect"
                        HorizontalAlignment="Stretch" IsVisible="False" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
