<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Shrike.App.Views.ExportDialog"
        Title="Export"
        Width="480" SizeToContent="Height"
        CanResize="False"
        Background="#140F0A"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="Button.tool">
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Background" Value="#2A2318" />
            <Setter Property="Foreground" Value="#EDE6DA" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A2F1E" />
            <Setter Property="BorderBrush" Value="#F5A524" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#F5A524" />
            <Setter Property="Foreground" Value="#140F0A" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFB840" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="#9A8F7D" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#EDE6DA" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="18" Spacing="12">
        <TextBlock Classes="label" Text="Preset" />
        <ComboBox Name="PresetBox" HorizontalAlignment="Stretch" SelectionChanged="OnPresetChanged" />

        <TextBlock Name="NoteText" Classes="hint" />

        <Border Background="#1C160E" CornerRadius="8" Padding="12">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" >
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="hint" Text="Output" Margin="0,0,12,4" />
                <TextBlock Grid.Row="0" Grid.Column="1" Name="SpecText" Classes="label" Margin="0,0,0,4" />
                <TextBlock Grid.Row="1" Grid.Column="0" Classes="hint" Text="Est. size" Margin="0,0,12,4" />
                <TextBlock Grid.Row="1" Grid.Column="1" Name="SizeText" Classes="label" Margin="0,0,0,4" />
                <TextBlock Grid.Row="2" Grid.Column="0" Classes="hint" Text="Length" Margin="0,0,12,0" />
                <TextBlock Grid.Row="2" Grid.Column="1" Name="LengthText" Classes="label" />
            </Grid>
        </Border>

        <StackPanel Name="ProgressPanel" Spacing="6" IsVisible="False">
            <ProgressBar Name="Bar" Minimum="0" Maximum="1" Height="6" Foreground="#F5A524" Background="#2A2318" />
            <TextBlock Name="StatusText" Classes="hint" Text="Exporting…" />
        </StackPanel>

        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <Button Grid.Column="0" Name="CancelButton" Classes="tool" Content="Cancel" Click="OnCancel" />
            <Button Grid.Column="2" Name="CopyButton" Classes="tool" Content="Copy file" Click="OnCopyFile" Margin="0,0,8,0" />
            <Button Grid.Column="3" Name="SaveButton" Classes="tool accent" Content="Save…" Click="OnSave" />
        </Grid>
    </StackPanel>
</Window>
