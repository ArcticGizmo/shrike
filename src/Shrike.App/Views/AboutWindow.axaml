<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Shrike.App.Views.AboutWindow"
        Title="About Shrike"
        Width="520" Height="560"
        CanResize="False"
        Background="#140F0A"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="Button.tool">
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Background" Value="#2A2318" />
            <Setter Property="Foreground" Value="#EDE6DA" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A2F1E" />
            <Setter Property="BorderBrush" Value="#F5A524" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#F5A524" />
            <Setter Property="Foreground" Value="#140F0A" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="Shrike" Foreground="#F5A524" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Name="VersionText" Foreground="#9A8F7D" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,3" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="A snappy, tray-resident capture studio for Windows."
                   Foreground="#9A8F7D" FontSize="12" Margin="0,4,0,12" />

        <Border Grid.Row="2" Background="#0E0B06" CornerRadius="8" Padding="12">
            <ScrollViewer>
                <TextBlock Name="ChangelogText" Foreground="#D8CFBF" FontSize="12"
                           FontFamily="Consolas,monospace" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,14,0,0">
            <Button Grid.Column="0" Name="CheckButton" Classes="tool" Content="Check for updates" Click="OnCheckUpdates" />
            <TextBlock Grid.Column="1" Name="UpdateStatus" Foreground="#9A8F7D" FontSize="12"
                       VerticalAlignment="Center" Margin="12,0" TextWrapping="Wrap" />
            <Button Grid.Column="2" Name="ApplyButton" Classes="tool accent" Content="Install &amp; restart"
                    Click="OnApply" IsVisible="False" Margin="0,0,8,0" />
            <Button Grid.Column="3" Classes="tool" Content="Close" Click="OnClose" />
        </Grid>
    </Grid>
</Window>
