<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Shrike.App.Views.CaptureMenuWindow"
        Title="Shrike Capture"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">

    <Window.Styles>
        <Style Selector="Button.mode">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Background" Value="#2A2318" />
            <Setter Property="Foreground" Value="#EDE6DA" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.mode:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A2F1E" />
            <Setter Property="BorderBrush" Value="#F5A524" />
        </Style>
        <Style Selector="Button.mode TextBlock.key">
            <Setter Property="Foreground" Value="#F5A524" />
            <Setter Property="FontFamily" Value="Consolas,monospace" />
            <Setter Property="Width" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Disabled row (e.g. Recent with an empty ring): dim, but keep the layout stable. -->
        <Style Selector="Button.mode:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <!-- Section label above a group of modes. -->
        <Style Selector="TextBlock.section">
            <Setter Property="FontFamily" Value="Consolas,monospace" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#8A7C68" />
            <Setter Property="LetterSpacing" Value="2" />
            <Setter Property="Margin" Value="7,6,0,1" />
        </Style>
        <!-- "+5s" badge on screenshot rows when a delay is armed. -->
        <Style Selector="TextBlock.badge">
            <Setter Property="Foreground" Value="#F5A524" />
            <Setter Property="FontFamily" Value="Consolas,monospace" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <!-- The delay modifier row's current value. -->
        <Style Selector="TextBlock.delayvalue">
            <Setter Property="FontFamily" Value="Consolas,monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Window.Styles>

    <Border Background="#F214110D" BorderBrush="#F5A524" BorderThickness="1" CornerRadius="12"
            Padding="8" BoxShadow="0 18 44 -18 #000000">
        <StackPanel Width="236" Spacing="2">
            <TextBlock Text="CAPTURE" FontFamily="Consolas,monospace" FontSize="11"
                       Foreground="#F5A524" LetterSpacing="3" Margin="6,2,0,2" />

            <TextBlock Classes="section" Text="SCREENSHOT" />
            <Button Name="RegionButton" Classes="mode" Click="OnRegion">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Classes="key" Text="1" />
                    <TextBlock Grid.Column="1" Text="Region or window" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="2" Name="RegionBadge" Classes="badge" IsVisible="False" />
                </Grid>
            </Button>
            <Button Name="MonitorButton" Classes="mode" Click="OnMonitor">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Classes="key" Text="2" />
                    <TextBlock Grid.Column="1" Text="This monitor" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="2" Name="MonitorBadge" Classes="badge" IsVisible="False" />
                </Grid>
            </Button>
            <Button Name="AllButton" Classes="mode" Click="OnAllMonitors">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Classes="key" Text="3" />
                    <TextBlock Grid.Column="1" Text="All monitors" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="2" Name="AllBadge" Classes="badge" IsVisible="False" />
                </Grid>
            </Button>

            <TextBlock Classes="section" Text="RECORD" />
            <Button Name="RecordButton" Classes="mode" Click="OnRecord">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Classes="key" Text="4" />
                    <TextBlock Grid.Column="1" Text="Record region" Margin="8,0,0,0" />
                </Grid>
            </Button>

            <TextBlock Classes="section" Text="TOOLS" />
            <Button Name="PipetteButton" Classes="mode" Click="OnPickColour">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Classes="key" Text="5" />
                    <TextBlock Grid.Column="1" Text="Pick colour" Margin="8,0,0,0" />
                </Grid>
            </Button>
            <Button Name="RecentButton" Classes="mode" Click="OnRecent">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Classes="key" Text="6" />
                    <TextBlock Grid.Column="1" Name="RecentText" Text="Recent captures" Margin="8,0,0,0" />
                </Grid>
            </Button>

            <Border Height="1" Background="#322A1E" Margin="4,5" />

            <Button Name="DelayButton" Classes="mode" Click="OnDelay">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Classes="key" Text="D" />
                    <TextBlock Grid.Column="1" Text="Delay" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="2" Name="DelayValue" Classes="delayvalue" Text="Off"
                               Foreground="#8A7C68" />
                </Grid>
            </Button>

            <TextBlock Text="1–6 pick  ·  D delay  ·  Esc cancel" FontSize="11" Foreground="#8A7C68"
                       Margin="6,5,0,2" />
        </StackPanel>
    </Border>
</Window>
